{
  id: 2026092101,
  name: 'daze0515的自定义规则',
  version: 5,
  author: 'daze0515',
  apps: [
    {
      id: 'com.qq.reader',
      name: 'QQ阅读',
      groups: [
        {
          key: 0,
          name: '开屏/热启动广告',
          desc: '跳过右上角跳过X按钮',
          matchTime: 10000,
          actionMaximum: 1,
          resetMatch: 'app',
          rules: [
            {
              matches: '[id="com.qq.reader:id/splash_root"] > TextView[text^="跳过"][clickable=true]',
              snapshotUrls: []
            }
          ]
        },
        {
          key: 1,
          name: '激励广告-无视频兜底',
          desc: '暂无可播视频时点击广告详情领取本次激励奖励',
          fastQuery: true,
          matchTime: 3500,
          forcedTime: 3000,
          resetMatch: 'activity',
          actionCd: 500,
          actionMaximum: 1,
          rules: [
            {
              key: 0,
              matches: [
                '[vid="tip_text"][text^="暂无可播视频"][visibleToUser=true]',
                '[vid="ad_button"][text="查看详情"][clickable=true][visibleToUser=true]'
              ],
              action: 'clickCenter',
              snapshotUrls: []
            }
          ]
        },
        {
          key: 2,
          name: '更新提示-取消更新',
          desc: '自动取消“安装新版本”提示',
          fastQuery: true,
          matchTime: 5000,
          forcedTime: 3000,
          resetMatch: 'activity',
          actionMaximum: 1,
          rules: [
            {
              key: 0,
              matches: '[id="com.qq.reader:id/cancelButton"][clickable=true][visibleToUser=true]',
              action: 'clickCenter',
              snapshotUrls: []
            }
          ]
        }
      ]
    }
  ]
}
